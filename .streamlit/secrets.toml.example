# Configuración de secretos para autenticación nativa con Google en Streamlit
# Copia este archivo como 'secrets.toml' en esta misma carpeta (.streamlit/) para desarrollo local,
# o agrégalo a la sección 'Secrets' en la configuración de tu aplicación en Streamlit Cloud.

[auth]
# Para desarrollo local, usa: "http://localhost:8501/_stcore/oauth_callback"
# Para producción en Streamlit Cloud, usa: "https://<tu-app>.streamlit.app/_stcore/oauth_callback"
redirect_uri = "http://localhost:8501/_stcore/oauth_callback"

# Clave secreta para firmar las cookies de sesión. Debe ser una cadena aleatoria y segura.
# Puedes generar una usando: python -c "import secrets; print(secrets.token_urlsafe(32))"
cookie_secret = "reemplazar_con_una_cadena_aleatoria_y_segura"

[auth.google]
# Obtén estas credenciales en la consola de Google Cloud (https://console.cloud.google.com)
client_id = "tu_client_id.apps.googleusercontent.com"
client_secret = "tu_client_secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
