# Database
DATABASE_URL=sqlite:///./dian_sim.db

# Tutor IA opcional. Gemini usa cuota gratuita; sin clave continúa el fallback.
AI_PROVIDER=gemini
MODEL_FAST=gemini-3.6-flash
MODEL_BALANCED=gemini-3.6-flash
MODEL_REASONING=gemini-3.6-flash

# Compatibilidad con los generadores existentes
LLM_PROVIDER=none
OPENAI_API_KEY=
GEMINI_API_KEY=

# App Settings
DEBUG=True

# Persistent Fernet key for encrypted API keys (required in cloud)
DIAN_SIM_FERNET_KEY=
