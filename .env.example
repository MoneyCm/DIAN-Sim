# Database
DATABASE_URL=sqlite:///./dian_sim.db

# Tutor IA opcional. Sin clave, el motor determinístico sigue funcionando.
AI_PROVIDER=none
MODEL_FAST=gpt-5.6-luna
MODEL_BALANCED=gpt-5.6-terra
MODEL_REASONING=gpt-5.6-sol

# Compatibilidad con los generadores existentes
LLM_PROVIDER=none
OPENAI_API_KEY=
GEMINI_API_KEY=

# App Settings
DEBUG=True

# Persistent Fernet key for encrypted API keys (required in cloud)
DIAN_SIM_FERNET_KEY=
