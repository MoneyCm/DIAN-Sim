# Database
DATABASE_URL=sqlite:///./dian_sim.db

# Runtime safety. In production set DIAN_SIM_ENV=production,
# REQUIRE_DATABASE_URL=true and provide a protected remote DATABASE_URL.
DIAN_SIM_ENV=development
REQUIRE_DATABASE_URL=false
AUTO_MIGRATE_SCHEMA=false
AUTO_SEED_OPEC_BANKS=false

# Tutor IA opcional. Gemini usa cuota gratuita; sin clave continúa el fallback.
AI_PROVIDER=gemini
MODEL_FAST=gemini-2.5-flash
MODEL_BALANCED=gemini-2.5-flash
MODEL_REASONING=gemini-2.5-flash

# Compatibilidad con los generadores existentes
LLM_PROVIDER=none
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# Persistent login cookie signing secret. Use a long random value in production.
AUTH_COOKIE_SECRET=

# Persistent Fernet key for encrypted API keys (required in cloud)
DIAN_SIM_FERNET_KEY=

# Provider-neutral AI budgets. Defaults are conservative and may be reduced.
AI_MAX_PROMPT_CHARS=120000
AI_MAX_CALLS_PER_JOB=25
AI_MAX_CALLS_PER_USER_DAY=80
AI_MAX_CALLS_GLOBAL_DAY=1000
AI_MAX_INPUT_TOKENS_PER_USER_DAY=300000
AI_MAX_OUTPUT_TOKENS_PER_USER_DAY=100000
AI_MAX_OUTPUT_TOKENS_PER_CALL=4096
